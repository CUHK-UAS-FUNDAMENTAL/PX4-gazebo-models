<?xml version="1.0" ?>
<!-- Red bar obstacle per rulebook Fig.9b.
     Two posts 1980mm tall, 1500mm apart (center-to-center).
     Horizontal bar default at 1600mm (middle step). Drone flies OVER.
     Cylinder radius 22.5mm (45mm diameter tubes). -->
<sdf version="1.9">
  <model name="red_bar">
    <static>true</static>

    <!-- Left post -->
    <link name="post_left">
      <pose>0 -0.75 0.99 0 0 0</pose>
      <collision name="col"><geometry><cylinder><radius>0.0225</radius><length>1.98</length></cylinder></geometry></collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.0225</radius><length>1.98</length></cylinder></geometry>
        <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <!-- Right post -->
    <link name="post_right">
      <pose>0 0.75 0.99 0 0 0</pose>
      <collision name="col"><geometry><cylinder><radius>0.0225</radius><length>1.98</length></cylinder></geometry></collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.0225</radius><length>1.98</length></cylinder></geometry>
        <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <!-- Horizontal bar at 1600mm (middle/default height). Cylinder rotated 90° to lie in Y. -->
    <link name="bar">
      <pose>0 0 1.6 1.5708 0 0</pose>
      <collision name="col"><geometry><cylinder><radius>0.0225</radius><length>1.5</length></cylinder></geometry></collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.0225</radius><length>1.5</length></cylinder></geometry>
        <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <!-- Height indicator pegs on left post (visual only): low=1.2m, mid=1.6m, high=1.98m -->
    <link name="peg_low">
      <pose>0.06 -0.75 1.2 0 1.5708 0</pose>
      <visual name="vis">
        <geometry><cylinder><radius>0.012</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
      </visual>
    </link>
    <link name="peg_mid">
      <pose>0.06 -0.75 1.6 0 1.5708 0</pose>
      <visual name="vis">
        <geometry><cylinder><radius>0.012</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
      </visual>
    </link>
    <link name="peg_high">
      <pose>0.06 -0.75 1.98 0 1.5708 0</pose>
      <visual name="vis">
        <geometry><cylinder><radius>0.012</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
      </visual>
    </link>

  </model>
</sdf>
