<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="dark_room">
    <static>true</static>

    <!-- ==================== FRONT WALL (with windows) ==================== -->
    <!-- Wall is at local x = -1.25, windows face +x direction -->

    <!-- Bottom strip: full width, below both windows -->
    <link name="front_bottom">
      <pose>-1.225 0 0.525 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>0.05 2.5 1.05</size></box></geometry>
        <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
      </visual>
      <collision name="col">
        <geometry><box><size>0.05 2.5 1.05</size></box></geometry>
      </collision>
    </link>

    <!-- Top strip: full width, above both windows -->
    <link name="front_top">
      <pose>-1.225 0 2.025 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>0.05 2.5 1.05</size></box></geometry>
        <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
      </visual>
      <collision name="col">
        <geometry><box><size>0.05 2.5 1.05</size></box></geometry>
      </collision>
    </link>

    <!-- Left panel: solid, left of red window -->
    <!-- Red window spans y: -0.75 to -0.35, width = 0.40m -->
    <link name="front_left">
      <pose>-1.225 -1.0 1.25 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>0.05 0.5 0.40</size></box></geometry>
        <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
      </visual>
      <collision name="col">
        <geometry><box><size>0.05 0.5 0.40</size></box></geometry>
      </collision>
    </link>

    <!-- Middle panel: between red and blue windows -->
    <!-- Between y=-0.35 and y=0.50, width = 0.85m -->
    <link name="front_middle">
      <pose>-1.225 0.075 1.25 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>0.05 0.85 0.40</size></box></geometry>
        <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
      </visual>
      <collision name="col">
        <geometry><box><size>0.05 0.85 0.40</size></box></geometry>
      </collision>
    </link>

    <!-- Right panel: right of blue window -->
    <!-- Blue window spans y: 0.50 to 1.00, width = 0.50m -->
    <link name="front_right">
      <pose>-1.225 1.125 1.25 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>0.05 0.25 0.40</size></box></geometry>
        <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
      </visual>
      <collision name="col">
        <geometry><box><size>0.05 0.25 0.40</size></box></geometry>
      </collision>
    </link>

    <!-- ==================== WINDOW FRAMES ==================== -->

    <!-- Red window frame (400x400mm opening) -->
    <!-- Top border -->
    <link name="red_win_top">
      <pose>-1.225 -0.55 1.475 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>0.04 0.44 0.05</size></box></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
      </visual>
      <collision name="col"><geometry><box><size>0.04 0.44 0.05</size></box></geometry></collision>
    </link>
    <!-- Bottom border -->
    <link name="red_win_bot">
      <pose>-1.225 -0.55 1.025 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>0.04 0.44 0.05</size></box></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
      </visual>
      <collision name="col"><geometry><box><size>0.04 0.44 0.05</size></box></geometry></collision>
    </link>
    <!-- Left border -->
    <link name="red_win_left">
      <pose>-1.225 -0.77 1.25 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>0.04 0.05 0.40</size></box></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
      </visual>
      <collision name="col"><geometry><box><size>0.04 0.05 0.40</size></box></geometry></collision>
    </link>
    <!-- Right border -->
    <link name="red_win_right">
      <pose>-1.225 -0.33 1.25 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>0.04 0.05 0.40</size></box></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
      </visual>
      <collision name="col"><geometry><box><size>0.04 0.05 0.40</size></box></geometry></collision>
    </link>

    <!-- Blue window frame (500x400mm opening) -->
    <!-- Top border -->
    <link name="blue_win_top">
      <pose>-1.225 0.75 1.475 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>0.04 0.54 0.05</size></box></geometry>
        <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
      </visual>
      <collision name="col"><geometry><box><size>0.04 0.54 0.05</size></box></geometry></collision>
    </link>
    <!-- Bottom border -->
    <link name="blue_win_bot">
      <pose>-1.225 0.75 1.025 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>0.04 0.54 0.05</size></box></geometry>
        <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
      </visual>
      <collision name="col"><geometry><box><size>0.04 0.54 0.05</size></box></geometry></collision>
    </link>
    <!-- Left border -->
    <link name="blue_win_left">
      <pose>-1.225 0.48 1.25 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>0.04 0.05 0.40</size></box></geometry>
        <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
      </visual>
      <collision name="col"><geometry><box><size>0.04 0.05 0.40</size></box></geometry></collision>
    </link>
    <!-- Right border -->
    <link name="blue_win_right">
      <pose>-1.225 1.02 1.25 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>0.04 0.05 0.40</size></box></geometry>
        <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
      </visual>
      <collision name="col"><geometry><box><size>0.04 0.05 0.40</size></box></geometry></collision>
    </link>

    <!-- ==================== REMAINING WALLS ==================== -->

    <!-- Back wall (solid) -->
    <link name="wall_back">
      <pose>1.225 0 1.25 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>0.05 2.5 2.5</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name="col"><geometry><box><size>0.05 2.5 2.5</size></box></geometry></collision>
    </link>

    <!-- Left wall -->
    <link name="wall_left">
      <pose>0 -1.225 1.25 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>2.5 0.05 2.5</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name="col"><geometry><box><size>2.5 0.05 2.5</size></box></geometry></collision>
    </link>

    <!-- Right wall -->
    <link name="wall_right">
      <pose>0 1.225 1.25 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>2.5 0.05 2.5</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name="col"><geometry><box><size>2.5 0.05 2.5</size></box></geometry></collision>
    </link>

    <!-- Ceiling -->
    <link name="ceiling">
      <pose>0 0 2.475 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>2.5 2.5 0.05</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <collision name="col"><geometry><box><size>2.5 2.5 0.05</size></box></geometry></collision>
    </link>

    <!-- ==================== INTERIOR LIGHT (very dim) ==================== -->
    <light name="interior_light" type="point">
      <pose>0 0 2.2 0 0 0</pose>
      <diffuse>0.05 0.05 0.05 1</diffuse>    <!-- very dark -->
      <specular>0 0 0 1</specular>
      <attenuation>
        <range>3</range>
        <linear>0.5</linear>
        <constant>0.8</constant>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ==================== BABY PLACEHOLDERS ==================== -->
    <!-- Reposition these on competition day -->

    <link name="baby_1">
      <pose>0.5 0.3 0.2 0 0 0</pose>
      <visual name="vis">
        <geometry><cylinder><radius>0.1</radius><length>0.35</length></cylinder></geometry>
        <material><ambient>0.9 0.8 0.7 1</ambient></material>
      </visual>
    </link>

    <link name="baby_2">
      <pose>-0.3 -0.4 0.2 0 0 0</pose>
      <visual name="vis">
        <geometry><cylinder><radius>0.1</radius><length>0.35</length></cylinder></geometry>
        <material><ambient>0.9 0.8 0.7 1</ambient></material>
      </visual>
    </link>

  </model>
</sdf>