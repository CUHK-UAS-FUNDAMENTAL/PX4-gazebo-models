<?xml version="1.0" ?>
<!-- Blue bar obstacle per rulebook Fig.10a.
     Two posts 1200mm tall, 1500mm apart. ONE horizontal bar (drone flies under).
     Bar default at 800mm (middle step). Marks at 400/800/1200mm. -->
<sdf version="1.9">
  <model name="blue_bar">
    <static>true</static>

    <!-- Left post -->
    <link name="post_left">
      <pose>0 -0.75 0.6 0 0 0</pose>
      <collision name="col"><geometry><cylinder><radius>0.0225</radius><length>1.2</length></cylinder></geometry></collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.0225</radius><length>1.2</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.8 1</ambient><diffuse>0.1 0.1 0.8 1</diffuse></material>
      </visual>
    </link>

    <!-- Right post -->
    <link name="post_right">
      <pose>0 0.75 0.6 0 0 0</pose>
      <collision name="col"><geometry><cylinder><radius>0.0225</radius><length>1.2</length></cylinder></geometry></collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.0225</radius><length>1.2</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.8 1</ambient><diffuse>0.1 0.1 0.8 1</diffuse></material>
      </visual>
    </link>

    <!-- Horizontal bar at 800mm (middle/default height). -->
    <link name="bar">
      <pose>0 0 0.8 1.5708 0 0</pose>
      <collision name="col"><geometry><cylinder><radius>0.0225</radius><length>1.5</length></cylinder></geometry></collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.0225</radius><length>1.5</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.8 1</ambient><diffuse>0.1 0.1 0.8 1</diffuse></material>
      </visual>
    </link>

    <!-- Height indicator pegs (visual only): low=0.4m, mid=0.8m, high=1.2m -->
    <link name="peg_low">
      <pose>0.06 -0.75 0.4 0 1.5708 0</pose>
      <visual name="vis">
        <geometry><cylinder><radius>0.012</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
      </visual>
    </link>
    <link name="peg_mid">
      <pose>0.06 -0.75 0.8 0 1.5708 0</pose>
      <visual name="vis">
        <geometry><cylinder><radius>0.012</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
      </visual>
    </link>
    <link name="peg_high">
      <pose>0.06 -0.75 1.2 0 1.5708 0</pose>
      <visual name="vis">
        <geometry><cylinder><radius>0.012</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
      </visual>
    </link>

  </model>
</sdf>
