<?xml version="1.0" ?>
<!-- Window frame obstacle per rulebook Fig.9a.
     Frame: 1500mm wide, 1200mm tall posts.
     Board inner span: 1000mm (y = -0.5 to +0.5).
     Blue window opening: 500x400mm at left, red opening: 400x400mm at right.
     Windows centered at z=0.7 (z=0.5 to 0.9). -->
<sdf version="1.9">
  <model name="window_frame">
    <static>true</static>

    <!-- Left post (y = -0.75) -->
    <link name="post_left">
      <pose>0 -0.75 0.6 0 0 0</pose>
      <collision name="col"><geometry><box><size>0.05 0.05 1.2</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>0.05 0.05 1.2</size></box></geometry>
        <material><ambient>0.55 0.27 0.07 1</ambient><diffuse>0.55 0.27 0.07 1</diffuse></material>
      </visual>
    </link>

    <!-- Right post (y = +0.75) -->
    <link name="post_right">
      <pose>0 0.75 0.6 0 0 0</pose>
      <collision name="col"><geometry><box><size>0.05 0.05 1.2</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>0.05 0.05 1.2</size></box></geometry>
        <material><ambient>0.55 0.27 0.07 1</ambient><diffuse>0.55 0.27 0.07 1</diffuse></material>
      </visual>
    </link>

    <!-- Board bottom panel: full width, below windows (z=0 to 0.5) -->
    <link name="board_bottom">
      <pose>0 0 0.25 0 0 0</pose>
      <collision name="col"><geometry><box><size>0.04 1.0 0.5</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>0.04 1.0 0.5</size></box></geometry>
        <material><ambient>0.65 0.45 0.2 1</ambient><diffuse>0.65 0.45 0.2 1</diffuse></material>
      </visual>
    </link>

    <!-- Board top panel: full width, above windows (z=0.9 to 1.2) -->
    <link name="board_top">
      <pose>0 0 1.05 0 0 0</pose>
      <collision name="col"><geometry><box><size>0.04 1.0 0.3</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>0.04 1.0 0.3</size></box></geometry>
        <material><ambient>0.65 0.45 0.2 1</ambient><diffuse>0.65 0.45 0.2 1</diffuse></material>
      </visual>
    </link>

    <!-- Board left sliver: left of blue window (y=-0.5 to -0.45), window level -->
    <link name="board_left_sliver">
      <pose>0 -0.475 0.7 0 0 0</pose>
      <collision name="col"><geometry><box><size>0.04 0.05 0.4</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>0.04 0.05 0.4</size></box></geometry>
        <material><ambient>0.65 0.45 0.2 1</ambient><diffuse>0.65 0.45 0.2 1</diffuse></material>
      </visual>
    </link>

    <!-- Board middle sliver: between windows (y=+0.05 to +0.10) -->
    <link name="board_mid_sliver">
      <pose>0 0.075 0.7 0 0 0</pose>
      <collision name="col"><geometry><box><size>0.04 0.05 0.4</size></box></geometry></collision>
      <visual name="vis">
        <geometry><box><size>0.04 0.05 0.4</size></box></geometry>
        <material><ambient>0.65 0.45 0.2 1</ambient><diffuse>0.65 0.45 0.2 1</diffuse></material>
      </visual>
    </link>

    <!-- Blue window border (visual only, no collision) -->
    <!-- Blue window spans y=-0.45 to +0.05, z=0.5 to 0.9 -->
    <link name="blue_border_top">
      <pose>-0.03 -0.20 0.92 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>0.02 0.54 0.04</size></box></geometry>
        <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
      </visual>
    </link>
    <link name="blue_border_bot">
      <pose>-0.03 -0.20 0.48 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>0.02 0.54 0.04</size></box></geometry>
        <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
      </visual>
    </link>
    <link name="blue_border_left">
      <pose>-0.03 -0.475 0.70 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>0.02 0.04 0.44</size></box></geometry>
        <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
      </visual>
    </link>
    <link name="blue_border_right">
      <pose>-0.03 0.025 0.70 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>0.02 0.04 0.44</size></box></geometry>
        <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
      </visual>
    </link>

    <!-- Red window border (visual only, no collision) -->
    <!-- Red window spans y=+0.10 to +0.50, z=0.5 to 0.9 -->
    <link name="red_border_top">
      <pose>-0.03 0.30 0.92 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>0.02 0.44 0.04</size></box></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
      </visual>
    </link>
    <link name="red_border_bot">
      <pose>-0.03 0.30 0.48 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>0.02 0.44 0.04</size></box></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
      </visual>
    </link>
    <link name="red_border_left">
      <pose>-0.03 0.075 0.70 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>0.02 0.04 0.44</size></box></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
      </visual>
    </link>
    <link name="red_border_right">
      <pose>-0.03 0.525 0.70 0 0 0</pose>
      <visual name="vis">
        <geometry><box><size>0.02 0.04 0.44</size></box></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
      </visual>
    </link>

  </model>
</sdf>
