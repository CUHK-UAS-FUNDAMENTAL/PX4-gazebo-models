<?xml version="1.0"?>
<sdf version="1.9">
  <model name="imav2026_copper_disc">
    <static>true</static>

    <link name="copper_disc_link">
      <visual name="copper_disc_visual">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.38 0.12 1</ambient>
          <diffuse>0.9 0.45 0.16 1</diffuse>
          <specular>0.6 0.45 0.25 1</specular>
        </material>
      </visual>

      <collision name="copper_disc_collision">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
      </collision>
      <sensor name="copper_disc_contact_sensor" type="contact">
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>

        <contact>
          <collision>copper_disc_collision</collision>
        </contact>

      </sensor>
    </link>
  </model>
</sdf>
