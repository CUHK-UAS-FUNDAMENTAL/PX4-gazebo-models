<?xml version="1.0" ?>
<!-- Three flower-textured floor strips as per rulebook Fig.7 -->
<sdf version="1.9">
  <model name="textured_floor">
    <static>true</static>
    <link name="link">

      <!-- Left side passage strip (Y = -1.5m) -->
      <visual name="left_strip">
        <pose>0 -1.5 0 0 0 0</pose>
        <geometry><box><size>12 0.6 0.002</size></box></geometry>
        <material>
          <pbr>
            <metal>
              <albedo_map>materials/flower_texture.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Center obstacle course strip (Y = 0) -->
      <visual name="center_strip">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>12 1.5 0.002</size></box></geometry>
        <material>
          <pbr>
            <metal>
              <albedo_map>materials/flower_texture.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Right side passage strip (Y = +1.5m) -->
      <visual name="right_strip">
        <pose>0 1.5 0 0 0 0</pose>
        <geometry><box><size>12 0.6 0.002</size></box></geometry>
        <material>
          <pbr>
            <metal>
              <albedo_map>materials/flower_texture.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

    </link>
  </model>
</sdf>
