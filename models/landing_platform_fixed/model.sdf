<?xml version="1.0" ?>
<!-- Fixed takeoff/landing platform with ArUco ID 0 on top surface.
     1.0 x 1.0m, 50mm thick. -->
<sdf version="1.9">
  <model name="landing_platform_fixed">
    <static>true</static>

    <link name="platform">
      <pose>0 0 0.025 0 0 0</pose>
      <collision name="col">
        <geometry><box><size>0.6 0.6 0.05</size></box></geometry>
      </collision>
      <visual name="vis">
        <geometry><box><size>0.6 0.6 0.05</size></box></geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>materials/textures/aruco_markers/id_0_takeoff.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>

  </model>
</sdf>
